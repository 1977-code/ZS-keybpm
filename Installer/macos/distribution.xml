<?xml version="1.0" encoding="utf-8"?>
<!--
    The macOS installer for ZS-keybpm.

    Three separate component packages, each its own checkbox, so an engineer who
    only ever loads VST3 is not handed an Audio Unit and an app they did not ask
    for. Everything installs into the system plug-in folders, which is what a DAW
    scans by default and what a second user account on the same machine expects to
    find.
-->
<installer-gui-script minSpecVersion="2">
    <title>ZS-keybpm</title>
    <organization>ru.zsrecords</organization>

    <background          file="watermark.png" alignment="bottomleft" scaling="tofit"/>
    <background-darkAqua file="watermark.png" alignment="bottomleft" scaling="tofit"/>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <license    file="license.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
        <line choice="support"/>
    </choices-outline>

    <choice id="vst3" title="VST3"
            description="ZS-keybpm.vst3 → /Library/Audio/Plug-Ins/VST3. Формат для Reaper, Cubase, Studio One, Live, FL Studio, Bitwig.">
        <pkg-ref id="ru.zsrecords.zskeybpm.vst3"/>
    </choice>

    <choice id="au" title="Audio Unit"
            description="ZS-keybpm.component → /Library/Audio/Plug-Ins/Components. Формат для Logic Pro и GarageBand.">
        <pkg-ref id="ru.zsrecords.zskeybpm.au"/>
    </choice>

    <choice id="standalone" title="Отдельное приложение"
            description="ZS-keybpm.app → /Applications. Слушает системный или внешний вход — темп и тональность можно снять без DAW.">
        <pkg-ref id="ru.zsrecords.zskeybpm.standalone"/>
    </choice>

    <!-- Not a choice at all: AGPLv3 requires a copy of itself to accompany the
         object code, and the OFL requires the same of the two font families
         compiled into the plug-in. So the licences install with everything, and
         there is no checkbox pretending otherwise. -->
    <choice id="support" title="Лицензии" visible="false" selected="true" enabled="false"
            description="LICENSE.txt и LICENSE-fonts.txt → /Library/Application Support/ZS Records/ZS-keybpm.">
        <pkg-ref id="ru.zsrecords.zskeybpm.support"/>
    </choice>

    <pkg-ref id="ru.zsrecords.zskeybpm.vst3"       version="0" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="ru.zsrecords.zskeybpm.au"         version="0" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="ru.zsrecords.zskeybpm.standalone" version="0" onConclusion="none">standalone.pkg</pkg-ref>
    <pkg-ref id="ru.zsrecords.zskeybpm.support"    version="0" onConclusion="none">support.pkg</pkg-ref>
</installer-gui-script>
